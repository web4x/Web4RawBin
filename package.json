{
  "name": "rawbin",
  "version": "0.8.119",
  "description": "RawBin — AI Server Management Interface",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:watch": "esbuild src/public/ts/app.ts --bundle --format=esm --target=es2020 --outfile=src/public/dist/app.js --sourcemap --watch",
    "dev": "tsx watch src/ts/server/server.ts",
    "start": "node scripts/start.mjs",
    "test": "node scripts/with-node20.mjs vitest run",
    "test:watch": "node scripts/with-node20.mjs vitest",
    "trace:check": "tsx src/ts/server/trace-cli.ts check",
    "trace:fix": "tsx src/ts/server/trace-cli.ts fix",
    "trace:audit": "tsx scripts/trace-audit.ts",
    "trace:audit:strict": "tsx scripts/trace-audit.ts --strict",
    "rule-pair:check": "tsx scripts/rule-pair-check.ts",
    "rule-pair:strict": "tsx scripts/rule-pair-check.ts --strict",
    "check:sprint-md": "tsx scripts/generate-sprint-md.ts --check --all",
    "check:camelcase": "node scripts/check-camelcase-names.mjs",
    "check:task-status": "node --import tsx src/ts/scenario/task-status.ts",
    "consistency:strict": "node --import tsx scripts/consistency-strict.ts",
    "test:marker:strict": "node --import tsx scripts/test-marker-audit.ts --strict",
    "impl:marker:strict": "node --import tsx scripts/impl-marker-audit.ts --strict",
    "check:sprint-label": "node --import tsx scripts/check-sprint-label.ts",
    "check:sprint-slug-dir": "node --import tsx scripts/check-sprint-slug-dir.ts",
    "check:regen-leaf": "node --import tsx scripts/check-regen-leaf.ts",
    "regen:overview": "node --import tsx scripts/sprint-overview.ts --write",
    "check:sprint-overview": "node --import tsx scripts/sprint-overview.ts",
    "regen:board": "node scripts/with-node20.mjs node --import tsx scripts/campaign-scoreboard-region.ts --write",
    "check:board": "node scripts/with-node20.mjs node --import tsx scripts/campaign-scoreboard-region.ts",
    "bite:board": "node scripts/with-node20.mjs node --import tsx scripts/campaign-scoreboard-region.ts --bite",
    "regen:approve": "node scripts/with-node20.mjs node --import tsx scripts/approve-queue-region.ts --write",
    "check:approve": "node scripts/with-node20.mjs node --import tsx scripts/approve-queue-region.ts",
    "bite:approve": "node scripts/with-node20.mjs node --import tsx scripts/approve-queue-region.ts --bite",
    "check:pin-single-source": "node --import tsx scripts/check-pin-single-source.ts --strict",
    "check:checklist-chain": "node --import tsx scripts/checklist-chain-audit.mjs",
    "check:facet-single-source": "node --import tsx scripts/check-facet-single-source.ts",
    "check:detail-bespoke": "node --import tsx scripts/check-detail-bespoke-actions.ts",
    "check:device-ac": "node scripts/check-device-ac-lint.mjs",
    "check:owned-output": "node --import tsx scripts/owned-output-guard-bites.ts",
    "check:deployment-typed-model": "node --import tsx scripts/check-deployment-typed-model.ts",
    "check:self-heal-on-read": "node --import tsx scripts/check-self-heal-on-read.ts",
    "check:controller-dominance": "node --import tsx scripts/check-controller-dominance.ts",
    "check:tree-emitter": "node --import tsx scripts/check-tree-emitter.ts",
    "check:deployment-default-view": "node --import tsx scripts/check-deployment-default-view.ts",
    "check:synthetic-ref-single-source": "node --import tsx scripts/check-synthetic-ref-single-source.ts",
    "check:viewbus-key-single-source": "node --import tsx scripts/check-viewbus-key-single-source.ts",
    "check:mutation-seam": "node --import tsx scripts/check-mutation-seam.ts --strict",
    "check:status-writes": "node --import tsx scripts/check-status-writes.ts",
    "check:reverse-wire": "node scripts/reverse-wire-audit.mjs",
    "check:release-tag": "node --import tsx scripts/check-release-tag.ts --strict",
    "backfill:r4018": "node --import tsx scripts/backfill-r40.18-lastadvancedat.ts",
    "trace:pii-guard": "node --import tsx scripts/trace-pii-guard.ts",
    "check:revoked-tokens": "node --import tsx scripts/check-revoked-tokens.ts",
    "check:storage-rekey-security": "node --import tsx scripts/check-storage-rekey-security.ts",
    "gen:revoked-tokens": "node --import tsx scripts/gen-revoked-tokens.ts",
    "gate:device:live": "node test/visual/r4012-music-player-pixel-gate.mjs && node test/visual/r4011-carveout-unresolved-gate.mjs && node test/visual/r4019-history-back-gate.mjs && node test/visual/r4010b-qa-verdict-ui-gate.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "ci:gates:raw": "npm run trace:audit:strict && npm run rule-pair:strict && npm run check:sprint-md && npm run check:camelcase && npm run check:task-status && npm run consistency:strict && npm run test:marker:strict && npm run impl:marker:strict && npm run check:sprint-label && npm run check:sprint-slug-dir && npm run check:regen-leaf && npm run check:detail-bespoke && npm run check:device-ac && npm run check:owned-output && npm run check:facet-single-source && npm run check:pin-single-source && npm run check:checklist-chain && npm run check:deployment-typed-model && npm run check:self-heal-on-read && npm run trace:pii-guard && npm run check:revoked-tokens && npm run check:storage-rekey-security && npm run check:controller-dominance && npm run check:tree-emitter && npm run check:deployment-default-view && npm run check:synthetic-ref-single-source && npm run check:viewbus-key-single-source && npm run check:mutation-seam && npm run check:status-writes && npm run check:reverse-wire && npm run check:release-tag && npm run check:board && npm run bite:board",
    "ci:gates": "node scripts/with-node20.mjs npm run ci:gates:raw",
    "migrate": "tsx src/ts/server/migrate-cli.ts all",
    "migrate:rooms": "tsx src/ts/server/migrate-cli.ts rooms",
    "migrate:userdirs": "tsx src/ts/server/migrate-cli.ts userdirs",
    "test:guard": "if grep -rn ':4444' test/e2e/ test/playwright/ --include='*.ts' 2>/dev/null | grep -v system-tester | grep -v playwright.config | grep -v avatar-bug-repro | grep -q ':4444'; then echo 'FAIL: raw :4444 in E2E — use ensureSystemTester()' && exit 1; else echo 'PASS: no raw :4444 in E2E'; fi",
    "test:e2e": "playwright test",
    "test:e2e:editor": "playwright test test/e2e/editor.spec.ts",
    "test:e2e:rooms": "playwright test test/e2e/room-identity.spec.ts",
    "test:all": "npm test && npm run test:e2e"
  },
  "keywords": [
    "server-management",
    "pwa",
    "https",
    "ai-assistant"
  ],
  "author": "Web4RawBin",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@types/node-fetch": "^2.6.13",
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.0",
    "jsdom": "^29.1.1",
    "marked": "^18.0.4",
    "node-fetch": "^3.3.2",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "ws": "^8.18.3"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "xterm": "^5.3.0"
  }
}
