  }

  class "TraceConsistency" as TC {
    [class:uuid:f5cf7284-59d4-4e76-8f80-b67ee9ca89f9]
    --
    [method:uuid:055a7f68-1d9a-4b0b-8c1c-d0d0d0d0d005]
    + auditOrphans(): Issue[]
    [method:uuid:963b67a2-488b-4c2c-8d3d-c0c0c0c0c096]
    + scanRepo(): {graph, coverage}
    [method:uuid:3dc29df9-0dac-4d4d-8e5e-b0b0b0b0b03d]
