  }

  class "TraceConsistency" as TC {
    [class:uuid:f5cf7284-59d4-4e76-8f80-b67ee9ca89f9]
    --
    [method:uuid:055a7f68-1d98-4a95-9572-22dcb0c40712]
    + auditOrphans(): Issue[]
    [method:uuid:963b67a2-488c-4580-b5ba-697537f02754]
