@startuml s17-architecture
!theme plain
skinparam classAttributeIconSize 0
skinparam defaultFontSize 8
skinparam backgroundColor White
skinparam linetype ortho

title Sprint 17 — Scenario Units: Class Architecture\nTree hierarchy + IOR chain + TraceModel typed graph

' ═══════════════════════════════════════════════════════════════
' Tree Base (T175 — generic, reusable beyond traceability)
' ═══════════════════════════════════════════════════════════════

package "Tree (generic base)" as TREE #E8F5E9 {

  abstract class "TraceObject" as TO {
    [class:uuid:101a0b1c-2d3e-4f50-8617-a01010101101]
    --
    + uuid: string
    + title: string
    + type: ObjectType
    + status: string
    + sprint: string
    # graph: TraceGraph
    - _links: Map<string, Set<string>>
    --
    [method:uuid:101a0b1c-0001-4a01-a001-000000000001]
    + get parent(): TraceObject | null
    [method:uuid:101a0b1c-0002-4a02-a002-000000000002]
    + get children(): TraceObject[]
    [method:uuid:101a0b1c-0003-4a03-a003-000000000003]
    + refs(relation): string[]
    [method:uuid:101a0b1c-0004-4a04-a004-000000000004]
    + addRef(relation, uuid): void
    [method:uuid:101a0b1c-0005-4a05-a005-000000000005]
    + ref(): ObjectRef
    [method:uuid:101a0b1c-0006-4a06-a006-000000000006]
    + toJSON(): FlatObject
  }

  class "TraceGraph" as TG {
    - byUuid: Map<string, TraceObject>
    --
    + register(obj): void
    + get(uuid): TraceObject
    + all(): TraceObject[]
    + ofType(type): TraceObject[]
    + link(a, relation, b, inverse): void
    + resolve(obj, relation, type): T[]
    + toJSON(): FlatObject[]
    .. static ..
    + fromJSON(records): TraceGraph
  }

  TG *-- TO : owns
}

' ═══════════════════════════════════════════════════════════════
' Typed Chain (T168 LOCKED 7-step — extends TraceObject)
' ═══════════════════════════════════════════════════════════════

package "LOCKED 7-step chain" as CHAIN #E3F2FD {

  class "Requirement" as REQ {
    + type = 'requirement'
    + addTask(t): this
    + get tasks(): Task[]
  }

  class "Task" as TASK {
    + type = 'task'
    + addUseCase(u): this
    + get useCases(): UseCase[]
  }

  class "UseCase" as UC {
    + type = 'usecase'
    + addClass(c): this
    + get classes(): TraceClass[]
  }

  class "TraceClass" as CLS {
    + type = 'class'
    + addMethod(m): this
    + get methods(): Method[]
  }

  class "Method" as MTH {
    + type = 'method'
    + addImplementation(i): this
    + get implementations(): Implementation[]
  }

  class "Implementation" as IMPL {
    + type = 'implementation'
    + addTest(t): this
    + get tests(): Test[]
  }

  class "Test" as TST {
    + type = 'test'
  }
}

TO <|-- REQ
TO <|-- TASK
TO <|-- UC
TO <|-- CLS
TO <|-- MTH
TO <|-- IMPL
TO <|-- TST

REQ -[#2E7D32]-> TASK : tasks\n(forward)
TASK -[#2E7D32]-> UC : useCases\n(forward)
UC -[#2E7D32]-> CLS : classes\n(forward)
CLS -[#2E7D32]-> MTH : methods\n(forward)
MTH -[#2E7D32]-> IMPL : implementations\n(forward)
IMPL -[#2E7D32]-> TST : tests\n(forward)

' ═══════════════════════════════════════════════════════════════
' View Components (S14/S15/S16 — extend HTMLElement)
' ═══════════════════════════════════════════════════════════════

package "View Components (client)" as VIEWS #FFF3E0 {

  class "RbTraceTree" as RTT {
    [class:uuid:108b7283-94a5-46b7-898e-b08080808108]
    <<rb-trace-tree>>
    --
    + graph: TraceGraph
    + setGraph(graph): void
    [method:uuid:108b7283-0001-4a01-a001-000000000001]
    + render(): void
    [method:uuid:108b7283-0002-4a02-a002-000000000002]
    - nodeEl(ref, ancestry): HTMLElement
    [method:uuid:108b7283-0003-4a03-a003-000000000003]
    - renderSeed(uuid): Promise
  }

  class "RbObjectItem" as ROI {
    [class:uuid:3bc876b5-594c-49f3-962b-84623de2aaff]
    <<rb-object-item>>
    --
    [method:uuid:f7629f0e-6b0e-4f62-a389-e0e0e0e0e0f7]
    + render(): void
    [method:uuid:bac0abd4-c15d-4e26-8b37-d0d0d0d0d0ba]
    + generateName(): string
    [method:uuid:ee69e091-ad0a-4b19-8c28-c0c0c0c0c0ee]
    + setIcon(): void
    [method:uuid:0a78eab3-f3e2-4a30-9d49-b0b0b0b0b00a]
    + drag(): void
    [method:uuid:75e6419f-db36-4b41-8e5a-a0a0a0a0a075]
    + collapse(): void
  }

  class "RbDetailDrawer" as RDD {
    [class:uuid:0dd08b2f-30ba-433f-a9de-285065f3fb8e]
    <<rb-detail-drawer>>
    --
    [method:uuid:d2935088-2a3b-4c4d-8e5f-f0f0f0f0f0d2]
    + open(ref): void
    [method:uuid:f4b0acec-cf5e-4d6f-8071-e0e0e0e0e0f4]
    + close(): void
    [method:uuid:9a0914b8-415c-4d6e-8f70-d0d0d0d0d09a]
    + swipeDismiss(): void
  }

  class "RbTaskDetail" as RTD {
    [class:uuid:4df19279-f2b8-438d-97b8-03fb37e049d5]
    <<rb-task-detail>>
    --
    [method:uuid:e9e78526-d441-4e52-8f63-c0c0c0c0c0e9]
    + render(): void
  }

  class "RbRequirementDetail" as RRD {
    [class:uuid:5d9132cf-f49e-4d3b-bc67-5078d0d576d0]
    <<rb-requirement-detail>>
    --
    [method:uuid:f2930f5e-c74a-4b5b-8c6c-b0b0b0b0b0f2]
    + render(): void
  }

  class "RbUseCaseDetail" as RUD {
    [class:uuid:84a94745-95b3-406c-8180-56ccef63b31b]
    <<rb-usecase-detail>>
    --
    [method:uuid:00d9e37e-46e1-4f72-8083-a0a0a0a0a000]
    + render(): void
  }
}

RTT --> ROI : creates per node
RTT --> RDD : opens on click
RDD --> RTD : renders Task
RDD --> RRD : renders Requirement
RDD --> RUD : renders UseCase

