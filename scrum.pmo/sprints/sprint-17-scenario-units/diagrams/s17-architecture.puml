@startuml s17-architecture
!theme plain
skinparam classAttributeIconSize 0
skinparam defaultFontSize 8
skinparam backgroundColor White
skinparam linetype ortho

title Sprint 17 — Scenario Units: Class Architecture\nTree hierarchy + IOR chain + TraceModel typed graph

' ═══════════════════════════════════════════════════════════════
' Tree Base (T175 — generic, reusable beyond traceability)
' ═══════════════════════════════════════════════════════════════

package "Tree (generic base)" as TREE #E8F5E9 {

  abstract class "TraceObject" as TO {
    [class:uuid:101a0b1c-2d3e-4f50-8617-a01010101101]
    --
    + uuid: string
    + title: string
    + type: ObjectType
    + status: string
    + sprint: string
    # graph: TraceGraph
    - _links: Map<string, Set<string>>
    --
    [method:uuid:0887265f-6652-451b-8986-34b6a7f909b1]
    + get parent(): TraceObject | null
    [method:uuid:66484695-b395-4415-a676-299f67d8318b]
    + get children(): TraceObject[]
    [method:uuid:aed37375-3dfb-4434-81b0-f5ec7bbad7de]
    + refs(relation): string[]
    [method:uuid:e5540f15-4bf4-484a-8632-764c98aa52a9]
    + addRef(relation, uuid): void
    [method:uuid:7601e257-afe5-4495-a7b5-b4c4bf79c6ce]
    + ref(): ObjectRef
    [method:uuid:0d99b7e1-f423-48b2-8243-4fc6f8d2c6ea]
    + toJSON(): FlatObject
  }

  class "TraceGraph" as TG {
    - byUuid: Map<string, TraceObject>
    --
    + register(obj): void
    + get(uuid): TraceObject
    + all(): TraceObject[]
    + ofType(type): TraceObject[]
    + link(a, relation, b, inverse): void
    + resolve(obj, relation, type): T[]
    + toJSON(): FlatObject[]
    .. static ..
    + fromJSON(records): TraceGraph
  }

  TG *-- TO : owns
}

' ═══════════════════════════════════════════════════════════════
' Typed Chain (T168 LOCKED 7-step — extends TraceObject)
' ═══════════════════════════════════════════════════════════════

package "LOCKED 7-step chain" as CHAIN #E3F2FD {

  class "Requirement" as REQ {
    + type = 'requirement'
    + addTask(t): this
    + get tasks(): Task[]
  }

  class "Task" as TASK {
    + type = 'task'
    + addUseCase(u): this
    + get useCases(): UseCase[]
  }

  class "UseCase" as UC {
    + type = 'usecase'
    + addClass(c): this
    + get classes(): TraceClass[]
  }

  class "TraceClass" as CLS {
    + type = 'class'
    + addMethod(m): this
    + get methods(): Method[]
  }

  class "Method" as MTH {
    + type = 'method'
    + addImplementation(i): this
    + get implementations(): Implementation[]
  }

  class "Implementation" as IMPL {
    + type = 'implementation'
    + addTest(t): this
    + get tests(): Test[]
  }

  class "Test" as TST {
    + type = 'test'
  }
}

TO <|-- REQ
TO <|-- TASK
TO <|-- UC
TO <|-- CLS
TO <|-- MTH
TO <|-- IMPL
TO <|-- TST

REQ -[#2E7D32]-> TASK : tasks\n(forward)
TASK -[#2E7D32]-> UC : useCases\n(forward)
UC -[#2E7D32]-> CLS : classes\n(forward)
CLS -[#2E7D32]-> MTH : methods\n(forward)
MTH -[#2E7D32]-> IMPL : implementations\n(forward)
IMPL -[#2E7D32]-> TST : tests\n(forward)

' ═══════════════════════════════════════════════════════════════
' View Components (S14/S15/S16 — extend HTMLElement)
' ═══════════════════════════════════════════════════════════════

package "View Components (client)" as VIEWS #FFF3E0 {

  class "RbTraceTree" as RTT {
    [class:uuid:108b7283-94a5-46b7-898e-b08080808108]
    <<rb-trace-tree>>
    --
    + graph: TraceGraph
    + setGraph(graph): void
    [method:uuid:430de69a-f7e7-409b-8233-22298d6d578c]
    + render(): void
    [method:uuid:32ae650c-d936-4696-89cd-8f9369fdc52e]
    - nodeEl(ref, ancestry): HTMLElement
    [method:uuid:cd3ad57b-7314-4da6-88d0-1113ab508100]
    - renderSeed(uuid): Promise
  }

  class "RbObjectItem" as ROI {
    [class:uuid:3bc876b5-594c-49f3-962b-84623de2aaff]
    <<rb-object-item>>
    --
    [method:uuid:f7629f0e-6b0c-4c21-8166-aff7e7129f09]
    + render(): void
    [method:uuid:bac0abd4-c15b-40b8-ae6c-ef265f883a27]
    + generateName(): string
    [method:uuid:ee69e091-ad08-47d3-99b6-3747e4521ac0]
    + setIcon(): void
    [method:uuid:0a78eab3-f3e8-4391-89c8-0b764ed28f8d]
    + drag(): void
    [method:uuid:75e6419f-db35-47e4-b31d-177c0f778ca3]
    + collapse(): void
  }

  class "RbDetailDrawer" as RDD {
    [class:uuid:0dd08b2f-30ba-433f-a9de-285065f3fb8e]
    <<rb-detail-drawer>>
    --
    [method:uuid:d2935088-2a32-41e7-afd0-4e8195471ae2]
    + open(ref): void
    [method:uuid:f4b0acec-cf50-4916-9696-e89865bca632]
    + close(): void
    [method:uuid:9a0914b8-4158-4b90-a898-c082cff5c737]
    + swipeDismiss(): void
  }

  class "RbTaskDetail" as RTD {
    [class:uuid:4df19279-f2b8-438d-97b8-03fb37e049d5]
    <<rb-task-detail>>
    --
    [method:uuid:e9e78526-d44e-4920-8ef1-c0e8f0c62fe6]
    + render(): void
  }

  class "RbRequirementDetail" as RRD {
    [class:uuid:5d9132cf-f49e-4d3b-bc67-5078d0d576d0]
    <<rb-requirement-detail>>
    --
    [method:uuid:f2930f5e-c748-49f5-888e-2d3aaa9a9012]
    + render(): void
  }

  class "RbUseCaseDetail" as RUD {
    [class:uuid:84a94745-95b3-406c-8180-56ccef63b31b]
    <<rb-usecase-detail>>
    --
    [method:uuid:00d9e37e-46ef-40d1-9e1c-7243ace69729]
    + render(): void
  }
}

RTT --> ROI : creates per node
RTT --> RDD : opens on click
RDD --> RTD : renders Task
RDD --> RRD : renders Requirement
RDD --> RUD : renders UseCase

