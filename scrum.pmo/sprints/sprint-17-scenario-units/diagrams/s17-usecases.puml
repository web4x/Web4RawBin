@startuml s17-usecases
!theme plain
skinparam classAttributeIconSize 0
skinparam defaultFontSize 8
skinparam backgroundColor White

title Sprint 17 — Scenario Units: UseCase Instances\nIOR = Class Loader | model = domain attrs | ownerIor = parent

' ═══════════════════════════════════════════════════════════════
' Phase 1 — Data Model & Loading
' ═══════════════════════════════════════════════════════════════

package "Phase 1 — Data Model" as P1 #E8F5E9 {

  class "unit.load" <<UseCase>> {
    [uc:uuid:17a00101-0001-4a01-a001-000017010001]
    R17.1 + R17.2
    T124.1 / T125
    Read scenario JSON, resolve ior
    to class loader, instantiate,
    populate model + ownerIor
  }

  class "ior.resolveClass" <<UseCase>> {
    [uc:uuid:17a00102-0002-4a02-a002-000017010002]
    R17.2
    T124.1 / T125
    "ior:class:Task" → TaskLoader
    Class registry lookup
  }

  class "ior.resolveInstance" <<UseCase>> {
    [uc:uuid:17a00103-0003-4a03-a003-000017010003]
    R17.2
    T124.1 / T125
    "ior:instance:<uuid>" →
    load scenario from index by UUID
  }

  class "index.put" <<UseCase>> {
    [uc:uuid:17a00104-0004-4a04-a004-000017010004]
    R17.4
    T124.3 / T125
    Store <uuid>.scenario.json at
    scenario/index/<5-prefix>/
  }

  class "index.get" <<UseCase>> {
    [uc:uuid:17a00105-0005-4a05-a005-000017010005]
    R17.4
    T124.3 / T125
    Load scenario by UUID from index
  }
}

