' ═══════════════════════════════════════════════════════════════
' Implementing Classes
' ═══════════════════════════════════════════════════════════════

package "Classes" as CLS #F5F5F5 {
  class "ScenarioUnit" as SU {
    + ior: string
    + model: Record<string, any>
    + ownerIor: string | null
    + load(json): this
    + save(indexPath): void
  }
  class "IORResolver" as IR {
    + resolve(ior): ScenarioUnit | ClassLoader
    + resolveClass(ior): ClassLoader
    + resolveInstance(ior): ScenarioUnit
  }
  class "ClassRegistry" as CR {
    + register(name, loader): void
    + get(name): ClassLoader
    -- 7 loaders --
    TaskLoader, RequirementLoader,
    SprintLoader, UseCaseLoader,
    ClassLoader, MethodLoader, TestLoader
  }
  class "ScenarioIndex" as SI {
    + put(uuid, scenario): void
    + get(uuid): ScenarioUnit
    + prefix(uuid): string
  }
  class "SpeakingTree" as ST {
    + symlinkJson(sprint, tasks): void
    + generateMd(sprint, templates): void
  }
  class "ViewTemplateRegistry" as VT {
    + register(className, tmpl): void
    + renderHtml(scenario): string
    + renderMd(scenario): string
  }
}

' ═══════════════════════════════════════════════════════════════
' UC → Class links
' ═══════════════════════════════════════════════════════════════

"unit.load" --> SU : implements
"unit.load" --> IR : uses
"ior.resolveClass" --> IR : implements
"ior.resolveClass" --> CR : uses
"ior.resolveInstance" --> IR : implements
"ior.resolveInstance" --> SI : uses
"index.put" --> SI : implements
"index.get" --> SI : implements
"tree.symlinkJson" --> ST : implements
"tree.generateMd" --> ST : implements
"tree.generateMd" --> VT : uses
"view.renderHtml" --> VT : implements
"view.renderMd" --> VT : implements
"planning.generate" --> VT : uses
"migrate.sprintToScenario" --> SU : uses
"migrate.sprintToScenario" --> SI : uses
"migrate.preserveHierarchy" --> ST : uses

legend bottom right
  **ior field = CLASS LOADER** (not instance UUID)
  "ior:class:Task" → TaskLoader → processes model
  model.uuid = instance identity
  model.children = IOR array (relationships)
  ownerIor = parent instance IOR
endlegend

@enduml
