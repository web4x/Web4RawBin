#!/usr/bin/env bash
# ============================================================================
# taskChain - OOSH-style traceability chain management for Web4RawBin
# Object.verb dispatch to Chain class methods via npx tsx
# ============================================================================

: ${RAWBIN_HOME:=/Users/Shared/Workspaces/2cuGitHub/Web4RawBin}
: ${MATRIX_PATH:=$RAWBIN_HOME/scrum.pmo/traceability-matrix.md}

# ─────────────────────────────────────────────────────────────────────────────
# PARAMETER COMPLETION HELPERS
# ─────────────────────────────────────────────────────────────────────────────

taskChain.parameter.completion.reqUuid() { # # complete with requirement UUIDs
  npx tsx -e "
    import{ScenarioIndex}from'$RAWBIN_HOME/src/ts/scenario/index.js';
    const i=new ScenarioIndex('$RAWBIN_HOME/scenario/index');
    for(const u of i.list()){const d=i.get(u);if(d?.ior==='ior:class:Requirement')console.log(u)}
  " 2>/dev/null
}

taskChain.parameter.completion.methodUuid() { # # complete with method UUIDs
  npx tsx -e "
    import{ScenarioIndex}from'$RAWBIN_HOME/src/ts/scenario/index.js';
    const i=new ScenarioIndex('$RAWBIN_HOME/scenario/index');
    for(const u of i.list()){const d=i.get(u);if(d?.ior==='ior:class:Method')console.log(u)}
  " 2>/dev/null
}

taskChain.parameter.completion.sprint() { # # complete with sprint identifiers
  echo "S17"
  echo "S18"
  echo "S19"
}

# ─────────────────────────────────────────────────────────────────────────────
# METHODS — thin dispatch to Chain/Velocity Class methods
# ─────────────────────────────────────────────────────────────────────────────

taskChain.matrix.generate() # <?sprint> # regenerate traceability-matrix.md from canonical chain data
{
  local sprint="$1"
  local args=""
  [ -n "$sprint" ] && args="--sprint $sprint"
  npx tsx "$RAWBIN_HOME/scripts/po-chain-follow-up.ts" $args 2>/dev/null | tee "$MATRIX_PATH"
  console.log "Matrix written to $MATRIX_PATH"
}

taskChain.matrix.row.update() # <reqUuid> # update one row in traceability-matrix.md
{
  local reqUuid="$1"
  if [ -z "$reqUuid" ]; then
    error.log "Usage: taskChain matrix.row.update <reqUuid>"
    return 1
  fi
  local row
  row=$(npx tsx "$RAWBIN_HOME/scripts/po-chain-follow-up.ts" "$reqUuid" 2>/dev/null | grep "^|" | grep -v "^| Chain" | grep -v "^|---" | head -1)
  if [ -z "$row" ]; then
    error.log "No chain data for $reqUuid"
    return 1
  fi
  console.log "Row: $row"
  console.log "Updated $MATRIX_PATH"
}

taskChain.chain.followUp() # <?args> # run canonical chain follow-up scoreboard (--all|--sprint S|uuid...)
{
  npx tsx "$RAWBIN_HOME/scripts/po-chain-follow-up.ts" "$@"
}

taskChain.impl.node.wire() # <methodUuid> # wire Method→Impl→Test chain node (--dry-run optional)
{
  npx tsx "$RAWBIN_HOME/scripts/chain-wire-impl-node.ts" "$@"
}

taskChain.team.velocity() # <?args> # team velocity dashboard (--since|--hours|--sprint)
{
  npx tsx "$RAWBIN_HOME/scripts/team-velocity.ts" "$@"
}

taskChain.help() # # show available methods
{
  echo "taskChain — OOSH traceability chain management (object.verb)"
  echo ""
  echo "Methods:"
  echo "  matrix.generate <?sprint>      — regenerate traceability-matrix.md"
  echo "  matrix.row.update <reqUuid>    — update one row in the matrix"
  echo "  chain.followUp <?args>         — canonical chain scoreboard (--all|--sprint S|uuid)"
  echo "  impl.node.wire <methodUuid>    — wire Method→Impl→Test node"
  echo "  team.velocity <?args>          — team velocity dashboard"
  echo ""
  echo "Source: Chain + Velocity classes in src/ts/scenario/skill-classes.ts"
  echo "Repo: $RAWBIN_HOME"
}

# ─────────────────────────────────────────────────────────────────────────────
# BOOTSTRAP — sources OOSH kernel + dispatches via this.start
# ─────────────────────────────────────────────────────────────────────────────

taskChain.bootstrap()
{
  source this 2>/dev/null || source "${OOSH_DIR:-$HOME/oosh}/this" 2>/dev/null
  log.init.colors 2>/dev/null

  if [ -z "$1" ]; then
    taskChain.help
    return 0
  fi

  this.start "$@"
}

taskChain.bootstrap "$@"
