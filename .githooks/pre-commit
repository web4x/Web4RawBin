#!/bin/sh
# Pre-commit gate (req a90fdb9c1): reject snake_case (underscore) UseCase/Method names — correct-by-construction,
# so a snake_case unit name can never be committed (it caught names that slipped past manual review).
# Enable once per clone:  git config core.hooksPath .githooks
# Fast, node-only (no tsx). The heavier gates (trace-audit / rule-pair / sprint-md) run in CI via `npm run ci:gates`.
node scripts/check-camelcase-names.mjs || {
  echo "pre-commit BLOCKED: camelCase name gate failed — rename the snake_case UseCase/Method name(s) above." >&2
  exit 1
}

# Auto-regen + deletion-guard (T37.6): when staged scenario units change, regenerate the sprints.overview.md
# generated index INSIDE this commit and stage it — so committed-overview == regen-of-committed-units BY
# CONSTRUCTION (no human quiesce-window race); and refuse any staged deletion of a hand-authored scrum.pmo doc.
# Needs tsx, so it only spawns when scenario units are staged OR a scrum.pmo *.md is being deleted (fast path
# stays node-only). Node override: RB_NODE=/path/to/node (default /opt/node22/bin/node, else PATH node).
NEED_REGEN=0
git diff --cached --name-only | grep -qE '^scenario/index/.*\.scenario\.json$' && NEED_REGEN=1
git diff --cached --name-only --diff-filter=D | grep -qE '^scrum\.pmo/.*\.md$' && NEED_REGEN=1
if [ "$NEED_REGEN" = 1 ]; then
  RB_NODE="${RB_NODE:-/opt/node22/bin/node}"; [ -x "$RB_NODE" ] || RB_NODE="$(command -v node)"
  "$RB_NODE" --import tsx scripts/precommit-regen-overview.ts || {
    echo "pre-commit BLOCKED: sprints.overview.md auto-regen / deletion-check failed (fail-closed) — see above." >&2
    exit 1
  }
fi

# Per-sprint MD auto-regen (ITEM-1 HOLE FIX, PO 2026-08-17): the overview/board/approve regens above fire on a staged
# unit, but the per-sprint planning/requirements/task-MD were ONLY check:sprint-md POST-HOC (CI) — so a UNIT-ONLY tick
# (e.g. a task's statusChecklist advance, 1 file) landed a credit while its sprint's task-MD stayed STALE = "a credit
# landed and the board did not move". This regenerates the AFFECTED sprint's MD IN THE SAME COMMIT, reusing the SAME
# generator check:sprint-md uses (generate-sprint-md.ts) via a targeted resolver + self-stage. Fail-closed.
if [ "$NEED_REGEN" = 1 ]; then
  RB_NODE="${RB_NODE:-/opt/node22/bin/node}"; [ -x "$RB_NODE" ] || RB_NODE="$(command -v node)"
  "$RB_NODE" --import tsx scripts/precommit-regen-sprint-md.ts || {
    echo "pre-commit BLOCKED: per-sprint MD auto-regen failed (fail-closed) — see above." >&2
    exit 1
  }
fi

# Board auto-regen (T37.6 pattern, PO 2026-08-12): keep the campaign scoreboard's LIVE region in sync BY
# CONSTRUCTION so a credit/flip cannot land without the board moving. Trigger = staged scenario units OR a staged
# campaign-scoreboard script (GAP A: the classification/override logic lives IN the script, not units — editing it
# changes board values with NO unit staged, so the trigger must watch the script too). Fail-closed. Anti-sweep:
# only auto-stage the board if it had NO unstaged curated edits before the regen (never sweep the planner's
# in-progress curation into someone else's commit).
NEED_BOARD=0
git diff --cached --name-only | grep -qE '^scenario/index/.*\.scenario\.json$' && NEED_BOARD=1
git diff --cached --name-only | grep -qE '^scripts/campaign-scoreboard.*\.(mjs|ts)$' && NEED_BOARD=1
if [ "$NEED_BOARD" = 1 ]; then
  RB_NODE="${RB_NODE:-/opt/node22/bin/node}"; [ -x "$RB_NODE" ] || RB_NODE="$(command -v node)"
  "$RB_NODE" --import tsx scripts/campaign-scoreboard-region.ts --write --staged-guard
  BOARD_RC=$?
  if [ "$BOARD_RC" = 0 ]; then
    git add -- scrum.pmo/campaign-scoreboard.md
  elif [ "$BOARD_RC" = 3 ]; then
    # Exit 3 = the planner has UNSTAGED out-of-region curation: the writer regenerated the LIVE region in the working
    # tree but deliberately did NOT stage the board. Do NOT `git add` (would sweep the peer's curation). Non-blocking:
    # the board catches up on the next clean regen:board; --check flags any interim staleness. (PO 2026-08-17: an
    # out-of-region peer edit WARNS, never blocks — one agent's WIP must never block the whole fleet.)
    echo "pre-commit NOTE: campaign-scoreboard.md carries the planner's unstaged out-of-region curation — LIVE region regenerated locally but board NOT staged (not swept, not blocking)." >&2
  else
    echo "pre-commit BLOCKED: campaign-scoreboard.md LIVE-region auto-regen failed (fail-closed) — see above." >&2
    exit 1
  fi
fi

# Approve-queue auto-regen (Tron order #4, T37.6 pattern): keep the one-pass verdict-surface in sync BY
# CONSTRUCTION so a QA-Review credit/advance cannot land without the approve buckets moving. Trigger = staged
# scenario units (task status / Test evidence / device ACs) OR a staged approve-queue evidence/writer script.
NEED_APPROVE=0
git diff --cached --name-only | grep -qE '^scenario/index/.*\.scenario\.json$' && NEED_APPROVE=1
git diff --cached --name-only | grep -qE '^scripts/(qa-evidence-audit\.mjs|approve-queue-region\.ts)$' && NEED_APPROVE=1
if [ "$NEED_APPROVE" = 1 ]; then
  RB_NODE="${RB_NODE:-/opt/node22/bin/node}"; [ -x "$RB_NODE" ] || RB_NODE="$(command -v node)"
  "$RB_NODE" --import tsx scripts/approve-queue-region.ts --write --staged-guard
  APPROVE_RC=$?
  if [ "$APPROVE_RC" = 0 ]; then
    git add -- scrum.pmo/approve-queue.md
  elif [ "$APPROVE_RC" = 3 ]; then
    # Exit 3 = planner has unstaged out-of-region curation: surface regenerated locally, deliberately NOT staged. Do NOT
    # `git add` (would sweep). Non-blocking (PO 2026-08-17: out-of-region peer edit WARNs, never blocks the fleet).
    echo "pre-commit NOTE: approve-queue.md carries the planner's unstaged out-of-region curation — surface regenerated locally but NOT staged (not swept, not blocking)." >&2
  else
    echo "pre-commit BLOCKED: approve-queue.md verdict-surface auto-regen failed (fail-closed) — see above." >&2
    exit 1
  fi
fi
